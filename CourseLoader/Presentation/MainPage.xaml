<Page x:Class="CourseLoader.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CourseLoader.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
    <Grid utu:SafeArea.Insets="VisibleBounds" RowDefinitions="Auto,*,Auto">
        <utu:NavigationBar Content="{Binding Title}" />
        <mvux:FeedView Grid.Row="1" Source="{Binding Courses}" >
            <DataTemplate >
                <ListView ItemsSource="{Binding Data}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="8,4" ColumnSpacing="12">
                                <TextBlock Text="{Binding CourseName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="Load" Command="{Binding LoadCourseCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DataTemplate>
            <mvux:FeedView.ProgressTemplate>
                <DataTemplate>
                    <TextBlock Padding="16,8" HorizontalAlignment="Center" Text="Loading Courses..." />
                </DataTemplate>
            </mvux:FeedView.ProgressTemplate>
            <mvux:FeedView.ErrorTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="16,8" HorizontalAlignment="Center">
                        <TextBlock Text="Load Error: " Foreground="Red"/>
                        <TextBlock Text="{Binding Exception.Message}" Foreground="Red"/>
                    </StackPanel>
                </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
            <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                    <TextBlock Padding="16,8" HorizontalAlignment="Center" Text="No Courses Found." />
                </DataTemplate>
            </mvux:FeedView.NoneTemplate>
        </mvux:FeedView>
        <mvux:FeedView Grid.Row="2" Source="{Binding Courses}" >
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Padding="16,8" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Data.Count}" />
                    <TextBlock Text="courses" />
                </StackPanel>
            </DataTemplate>
            <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                    <TextBlock Text="0 courses." Padding="16,8" HorizontalAlignment="Center" />
                </DataTemplate>
            </mvux:FeedView.NoneTemplate>
        </mvux:FeedView>
    </Grid>
</Page>
